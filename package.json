{
  "name": "boardgame",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared/tsconfig.json",
    "typecheck:server": "tsc -p .nuxt/tsconfig.server.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply boardgame --local",
    "db:migrate:remote": "wrangler d1 migrations apply boardgame --remote",
    "verify:auth": "node scripts/verify-auth.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@lucide/vue": "^1.51.0",
    "@vee-validate/valibot": "^4.15.1",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-vue": "^8.6.0",
    "hono": "^4.13.12",
    "nuxt": "^4.5.2",
    "reka-ui": "^2.10.5",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.43",
    "vue-input-otp": "^0.4.0",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "shadcn-nuxt": "^2.8.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
